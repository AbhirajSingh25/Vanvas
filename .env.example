# ==========================================
# VANVAS by The Sorted Club - Environment Configuration
# ==========================================

# Core Application Settings
PROJECT_NAME="VANVAS API"
VERSION="1.0.0"
SECRET_KEY="vanvas-the-sorted-club-super-secret-key-himalayan-mist-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# In production, use PostgreSQL: postgresql://vanvas_user:password@localhost:5432/vanvas_db
# For zero-configuration local development, defaults automatically to SQLite
DATABASE_URL="sqlite:///./vanvas.db"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# External API Provider Credentials (Optional - Demo fallback active if empty)
MAPS_API_KEY=""
PLACES_API_KEY=""
WEATHER_API_KEY=""
TRANSPORT_API_KEY=""
HOTELS_API_KEY=""
IMAGE_PROVIDER="openai"
OPENAI_API_KEY="your_openai_api_key_here"
IMAGE_OUTPUT_DIR="frontend/public/images/destinations"
IMAGE_FORMAT="webp"
IMAGE_GENERATION_MODEL="gpt-image-2"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
