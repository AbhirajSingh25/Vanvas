# ==============================================================================
# VANVAS BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Core Application Settings
# Set ENVIRONMENT to 'development' for local work or 'production' for live deployments
ENVIRONMENT=development
PROJECT_NAME="VANVAS Backend API"
API_V1_STR="/api/v1"
# IN PRODUCTION: Generate and supply a strong random 64-character secret key.
# Default keys will be rejected by the server in production mode.
SECRET_KEY="vanvas_secret_jwt_signing_key_production_change_me"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Defaults to local SQLite if DATABASE_URL is not set)
DATABASE_URL=sqlite:///./vanvas.db
# DATABASE_URL=postgresql://user:password@localhost:5432/vanvas

# CORS Origins (Comma separated)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://vanvas.app"

# ------------------------------------------------------------------------------
# REAL DATA PROVIDERS & EXTERNAL INTEGRATIONS (OPTIONAL)
# When omitted, VANVAS gracefully uses its high-accuracy internal mountain engines
# and live Open-Meteo & OpenStreetMap providers with zero crashes.
# ------------------------------------------------------------------------------

# 1. Geocoding & Autocomplete Provider (Defaults to OpenStreetMap Nominatim Live)
GEOCODING_PROVIDER=live
# MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSI...

# 2. Weather & Satellite Meteorological API (Defaults to Open-Meteo Live API)
WEATHER_PROVIDER=live
# OPENWEATHER_API_KEY=your_openweather_api_key_here

# 3. Places & Landmarks Provider (Defaults to Live Normalized Provider)
PLACES_PROVIDER=live
# GOOGLE_PLACES_API_KEY=AIzaSy...

# 4. Routing & Distance Matrix (Defaults to Haversine + 1.45x Mountain Tortuosity Engine)
ROUTING_PROVIDER=haversine
# MAPBOX_DIRECTIONS_API_KEY=...

# 5. AI Reasoning & Travel Engine (Defaults to Structured Travel Intelligence Layer)
AI_PROVIDER=default
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite

# 6. Transport & Bus Network (HPTDC, Zingbus, HRTC, RedBus integration layer)
TRANSPORT_PROVIDER=demo

# 7. Hotels & Stays Provider (StayingAPI Live Engine & Amadeus GDS)
HOTELS_PROVIDER=demo
STAYINGAPI_KEY=
# AMADEUS_CLIENT_ID=
# 8. Transactional Email & OTP Verification Provider (Brevo HTTPS REST API)
# Render Free blocks outbound SMTP ports (25, 465, 587). VANVAS uses Brevo HTTPS API.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=thesortedclub@gmail.com
EMAIL_FROM_NAME=VANVAS
APP_PUBLIC_URL=https://vanvasai.vercel.app
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5

# Quick Brevo Setup for Render Production:
# 1. Create Brevo account at https://www.brevo.com
# 2. Add and verify thesortedclub@gmail.com as authorized sender in Senders & IP
# 3. Generate a Brevo API key from SMTP & API -> API Keys
# 4. Put BREVO_API_KEY into Render backend Environment Variables
# 5. Redeploy backend
# 6. Test registration with a real email address

