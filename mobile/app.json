{
  "expo": {
    "name": "VANVAS",
    "slug": "vanvas",
    "scheme": "vanvas",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#17352C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.vanvas.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VANVAS uses your location for I'M HERE arrival mode and nearby mountain discoveries.",
        "NSPhotoLibraryUsageDescription": "VANVAS accesses your photos to let you select and set your profile avatar."
      }
    },
    "android": {
      "package": "ai.vanvas.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#17352C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VANVAS accesses your photos to let you set your profile avatar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VANVAS uses your location for I'M HERE arrival mode and nearby mountain discoveries."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#17352C"
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}